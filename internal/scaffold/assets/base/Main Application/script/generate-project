#!/bin/sh
#
# Generate the starter Xcode project from project.yml.

set -eu

readonly SCRIPT_DIR=$( cd "$( dirname "$0" )" && pwd )
readonly SOURCE_DIR=$( cd "$SCRIPT_DIR/.." && pwd )

if ! command -v xcodegen >/dev/null 2>&1; then
  echo "error: XcodeGen is not installed. Run script/bootstrap first."
  exit 1
fi

exec xcodegen --spec "$SOURCE_DIR/project.yml" --project "$SOURCE_DIR"
